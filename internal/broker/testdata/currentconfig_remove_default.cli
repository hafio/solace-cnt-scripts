!   Unlocked Features:
!   Router: "xps-ps-01"
!   Redacted: "False"

! pragma:interpreter:relaxed-db-restore

home
enable
configure

! Disable Message Vpn: "default"
message-vpn "default"
  replication
    shutdown
    state "standby"
    exit
  rest
    rest-delivery-point "test"
      shutdown
      no client-profile
      exit
    exit
  shutdown
  exit

! Remove JNDI: ""
jndi message-vpn "default"
  shutdown
  no connection-factory "/jms/cf/default"
  exit

! Remove Client Username: "default"
client-username "default" message-vpn "default"
  shutdown
  no acl-profile
  no client-profile
  no guaranteed-endpoint-permission-override
  no password
  no subscription-manager
  exit

! Remove Message Vpn: "default"
message-vpn "default"
  no alias
  no bridging ssl server-certificate-validation enforce-trusted-common-name
  bridging ssl server-certificate-validation max-certificate-chain-depth 3
  bridging ssl server-certificate-validation validate-certificate-date
  bridging ssl server-certificate-validation validate-server-name
  no event connections thresholds
  no event service smf connections thresholds
  no event service web-transport connections thresholds
  no event service rest incoming connections thresholds
  no event service mqtt connections thresholds
  no event egress-message-rate thresholds
  no event ingress-message-rate thresholds
  no event large-message-threshold
  no event log-tag
  no event publish-client
  no event publish-message-vpn
  event publish-topic-format "smf"
  no event publish-subscription
  no event subscriptions thresholds
  authentication
    client-certificate
      no revocation-check-mode
      no username-source
      exit
    oauth
      default-profile ""
      exit
    exit
  authorization
    authorization-type "internal"
    ldap group-membership-attribute-name "memberOf"
    no ldap trim-client-username-domain
    exit
  distributed-cache-management
  no export-policy export-subscriptions
  no max-connections
  no max-subscriptions
  no semp-over-msgbus shutdown
  semp-over-msgbus show-cmds shutdown
  semp-over-msgbus admin-cmds shutdown
  semp-over-msgbus admin-cmds distributed-cache-cmds shutdown
  semp-over-msgbus admin-cmds client-cmds shutdown
  rest
    rest-delivery-point "test"
      no service
      no vendor
      shutdown
      rest-consumer "test-rc"
        shutdown
        authentication
          auth-scheme "none"
          no aws access-key-id
          no aws secret-access-key
          no aws region
          no aws service
          no http-basic username
          no http-header name
          no http-header value
          no oauth-client client-id
          no oauth-client client-secret
          no oauth-client scope
          no oauth-client token-endpoint
          no oauth-client proxy
          no oauth-client token-expiry-default
          no oauth-jwt secret-key
          no oauth-jwt token-endpoint
          no oauth-jwt proxy
          no oauth-jwt token-expiry-default
          exit
        no local interface
        no remote host
        no remote max-post-wait-time
        no remote outgoing-connection-count
        no remote port
        remote proxy ""
        no remote http-method
        no remote retry delay
        no remote ssl
        ssl cipher-suite "default"
        ssl trusted-common-name "empty"
        no status-codes rejected
        exit
      no rest-consumer "test-rc"
      no queue-binding "test-rdp"
      exit
    no rest-delivery-point "test"
    no ssl server-certificate-validation enforce-trusted-common-name
    ssl server-certificate-validation max-certificate-chain-depth 3
    ssl server-certificate-validation validate-certificate-date
    ssl server-certificate-validation validate-server-name
    exit
  replication
    no ack-propagation interval messages
    no ack-propagation shutdown
    no transaction-replication-mode
    no reject-msg-when-sync-ineligible
    bridge authentication auth-scheme basic
    no bridge authentication basic client-username
    no bridge compressed-data
    no bridge message-spool window-size
    no bridge retry-delay
    no bridge ssl
    no bridge unidirectional client-profile
    no queue max-spool-usage
    queue reject-msg-to-sender-on-discard
    exit
  no service smf max-connections
  no service smf plain-text shutdown
  no service smf ssl shutdown
  service web-transport authentication client-certificate request-client-certificate "when-enabled-in-message-vpn"
  service web-transport max-connections 1000
  service rest incoming authentication client-certificate request-client-certificate "when-enabled-in-message-vpn"
  service rest incoming authorization-header-handling "drop"
  no service rest incoming max-connections
  service rest incoming plain-text shutdown
  no service rest incoming listen-port
  service rest incoming ssl shutdown
  no service rest incoming listen-port ssl
  service rest outgoing max-connections 6000
  service mqtt authentication client-certificate request-client-certificate "when-enabled-in-message-vpn"
  service mqtt max-connections 1000
  service mqtt plain-text shutdown
  no service mqtt listen-port
  service mqtt ssl shutdown
  no service mqtt listen-port ssl
  service mqtt websocket shutdown
  no service mqtt listen-port web
  service mqtt websocket-secure shutdown
  no service mqtt listen-port ssl web
  service amqp max-connections 1000
  service amqp plain-text shutdown
  no service amqp listen-port
  service amqp ssl shutdown
  no service amqp listen-port ssl
  no service web-transport plain-text shutdown
  no service web-transport ssl shutdown
  ssl
    no allow-downgrade-to-plain-text
    exit
  dynamic-message-routing
    shutdown
    exit
  mqtt
    retain
      no max-memory
      exit
    exit
  kafka
    max-broker-connections 0
    exit
  exit

! Remove Client Profile: "default"
client-profile "default" message-vpn "default"
  no event connections-per-client-username thresholds
  no event subscriptions thresholds
  no event client-provisioned-endpoint-spool-usage thresholds
  no event transacted-sessions thresholds
  no event transactions thresholds
  no event endpoints-per-client-username thresholds
  no event egress-flows thresholds
  no event ingress-flows thresholds
  no event service smf connections-per-client-username thresholds
  no event service web-transport connections-per-client-username thresholds
  no allow-bridge-connections
  no allow-shared-subscriptions
  no eliding delay
  no eliding max-topics
  eliding shutdown
  no service min-keepalive-timeout
  no service smf max-connections-per-client-username
  no service smf min-keepalive-enabled
  service web-transport max-connections-per-client-username 1000
  no max-connections-per-client-username
  no max-subscriptions
  no message-spool allow-guaranteed-endpoint-create
  no message-spool allow-guaranteed-endpoint-create-durability
  no message-spool allow-guaranteed-message-receive
  no message-spool allow-guaranteed-message-send
  no message-spool allow-transacted-sessions
  no message-spool max-transacted-sessions
  no message-spool max-transactions
  no message-spool max-messages-per-transaction
  no message-spool max-endpoints-per-client-username
  no message-spool max-egress-flows
  no message-spool max-ingress-flows
  no message-spool api-queue-management copy-from-on-create
  no message-spool api-queue-management copy-from-template-on-create
  no message-spool api-topic-endpoint-management copy-from-on-create
  no message-spool api-topic-endpoint-management copy-from-template-on-create
  no message-spool reject-msg-to-sender-on-no-subscription-match
  queue "G-1"
    no max-depth
    no min-msg-burst
    exit
  queue "D-1"
    no max-depth
    no min-msg-burst
    exit
  queue "D-2"
    no max-depth
    no min-msg-burst
    exit
  queue "D-3"
    no max-depth
    no min-msg-burst
    exit
  queue "C-1"
    no max-depth
    no min-msg-burst
    exit
  no tcp keepalive count
  no tcp keepalive idle
  no tcp keepalive interval
  no tcp mss
  no replication allow-clients-when-standby
  no amqp max-links
  no mqtt full-qos2
  exit

! Remove Endpoints: ""
message-spool message-vpn "default"
  queue "test-rdp"
    shutdown
    no max-ttl
    no dead-message-queue
    consumer-ack-propagation
    redelivery
    no delivery-count
    delivery-delay 0
    redelivery-delay shutdown
    redelivery-delay initial-interval 1000
    redelivery-delay max-interval 64000
    redelivery-delay multiplier "2.00"
    no respect-dmq-eligible
    no respect-message-priority
    partition count 0
    partition rebalance delay 5
    partition rebalance max-handoff-time 3
    exit
  no queue "test-rdp"
  exit

! Remove Message Spool: ""
message-spool message-vpn "default"
  no event transactions thresholds
  no event spool-usage thresholds
  no event transacted-sessions thresholds
  no event endpoints thresholds
  no event egress-flows thresholds
  no event ingress-flows thresholds
  no max-spool-usage
  no max-transacted-sessions
  no max-transactions
  no max-endpoints
  no max-egress-flows
  no max-ingress-flows
  no max-transactions
  allow-dmq-eligible-endpoint-override
  exit

! Remove MQTT Retain Cache: 

! Remove MQTT Sessions: 

! Remove Telemetry Profiles: 

! Remove ACL Profile: "default"
acl-profile "default" message-vpn "default"
  client-connect default-action "allow"
  publish-topic default-action "allow"
  subscribe-topic default-action "allow"
  subscribe-share-name default-action "allow"
  exit

! Remove Replay Log: "default"

! Remove Oauth Providers: "default"

! Remove Oauth Profiles: "default"

! Remove Queue Templates: "default"

! Remove Topic Endpoint Templates: "default"

