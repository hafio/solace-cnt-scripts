 ! BEGIN
! Command: "show current-config all"
! Generated by:
!   Username: "testuser"
!   Date: "2026-01-01T00:00:00.000Z"
!   Version: "99.99.9.9999"
!   dbVersion: "1"
!   SEMP Schema Version: "broker/99.99.9.9999"
!   Unlocked Features:
!   Router: "test-router"
!   Redacted: "False"

! pragma:interpreter:relaxed-db-restore

home
enable
configure

! Create All: "Message Vpns"
create message-vpn "A VPN WITH LONG NAME AND SPACES"
  exit
create message-vpn "simple-vpn"
  exit

! Configure System:
system scaling  scale  max-connections 1000 max-bridges 25
system health disk-latency-high-threshold 10000000

! Configure SolOsPhy Interfaces:
! pragma:interpreter:ignore-already-exists
create interface "intf0" vrf management
! pragma:interpreter:no-ignore-already-exists
  os-physical-interface "eth0"
  exit

! Configure ip vrf: "management"
ip vrf "management"
  exit

! Create Message Vpn: "simple-vpn"
message-vpn "simple-vpn"
  no alias
  authentication
    basic auth-type internal
    exit
  authorization
    authorization-type internal
    exit
  max-spool-usage 0
  exit

! Create Client Username: "app1"
client-username "app1" message-vpn "simple-vpn"
  no shutdown
  exit

! END
