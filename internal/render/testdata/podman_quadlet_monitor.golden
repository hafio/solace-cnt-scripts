[Unit]
Description=Solace PubSub+ Event Broker (solace-monitor, nodetype=monitoring)
Wants=network-online.target
After=network-online.target

[Container]
Image=registry.example.com/solace-pubsub-standard:10.26.0.8755
ContainerName=solace
HostName=solace-monitor
User=1000001
Group=0
PodmanArgs=--cpuset-cpus=0
Memory=2g
ShmSize=2g
Ulimit=nofile=2448:1048576
Ulimit=memlock=-1
Ulimit=core=-1
Network=host
Volume=/opt/solace/data:/var/lib/solace:Z
Volume=/etc/solace/solace-tls-servercertificate.pem:/mnt/certs/server/tls.pem:ro,Z
Environment="routername=solace-monitor"
Environment="nodetype=monitoring"
Environment="redundancy_enable=yes"
Environment="configsync_enable=yes"
Environment="redundancy_group_node_solace-primary_connectvia=10.0.0.11"
Environment="redundancy_group_node_solace-primary_nodetype=message_routing"
Environment="redundancy_group_node_solace-backup_connectvia=10.0.0.12"
Environment="redundancy_group_node_solace-backup_nodetype=message_routing"
Environment="redundancy_group_node_solace-monitor_connectvia=10.0.0.13"
Environment="redundancy_group_node_solace-monitor_nodetype=monitoring"
Environment="configsync_tls_enable=yes"
Environment="redundancy_matelink_tls_enable=yes"
Environment="tls_servercertificate_filepath=/mnt/certs/server/tls.pem"
Environment="system_scaling_maxconnectioncount=1000"
Environment="system_scaling_maxqueuemessagecount=100"
Environment="system_scaling_maxkafkabridgecount=0"
Environment="system_scaling_maxkafkabrokerconnectioncount=0"
Environment="system_scaling_maxbridgecount=25"
Environment="system_scaling_maxsubscriptioncount=50000"
Environment="system_scaling_maxguaranteedmessagesize=10"
Environment="messagespool_maxspoolusage=100000"
Environment="username_admin_globalaccesslevel=admin"
Environment="username_admin_passwordfilepath=/mnt/secrets/username_admin_password"
Environment="redundancy_authentication_presharedkey_keyfilepath=/mnt/secrets/redundancy_authentication_presharedkey_key"
Secret=solace-admin-password,type=mount,target=/mnt/secrets/username_admin_password
Secret=solace-redundancy-psk,type=mount,target=/mnt/secrets/redundancy_authentication_presharedkey_key

[Service]
LimitNOFILE=2448:1048576
LimitMEMLOCK=infinity
LimitCORE=infinity
Restart=always

[Install]
WantedBy=multi-user.target
